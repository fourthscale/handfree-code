{
  "description": "handfree-code: read replies and questions aloud, inject the voice rules (on the Mac, or through the bridge from a cloud session)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" --session-rules"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*spokenly.*__ask_user_dictation",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" --question",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|mcp__.*ccd_session__start_session|mcp__.*ccd_turn__wrap_up",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" --guard-question",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*spokenly.*__ask_user_dictation",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" --answered",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*spokenly.*__ask_user_dictation",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" --answered",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" --permission",
            "timeout": 150
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" --notify"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" --prompt-sent",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
